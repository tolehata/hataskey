		"faces": "chara/kiyoba/face_{n}.webp",
		"lines": [
			{
				"text": "あの、うちの孫を見ませんでしたか",
				"tags": [
					"初回"
				]
			},
			{
				"text": "今日はいい天気で。探し物日和ですよ",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "背はね、これくらい。……いや、もう少しあるかしら",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "花屋さんは朝が早いんでしょう。えらいわ",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "この通り、昔はもっと店がありましてね",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "八重さんとこの大根、今日は安いですよ",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "歩くのは苦じゃないんです。足だけは丈夫で",
				"tags": [
					"序盤"
				]
			},
			{
				"text": "そういえば、髪は短かったかしら。長かったかしら",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "くろまつのマスターは、いつ行っても喋らない",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "お茶をいただいてきました。二杯も",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "あなた、若いのにしっかりしてますね",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "孫はね、まあ、そのうち出てきますよ",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "急ぐ用でもないんです。急ぐ用でもね",
				"tags": [
					"中盤"
				]
			},
			{
				"text": "そろそろ帰らないと、怒られるかしらね",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "日が傾いてきましたね",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "ずいぶん歩きました。楽しかった",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "明日も探しに来ようかしら",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "見つからないほうが、長く歩けますでしょう",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "ここのお店、また寄らせてもらいます",
				"tags": [
					"終盤"
				]
			},
			{
				"text": "憶え書き、そんなに集めてどうするんです",
				"tags": [
					"点あり"
				]
			},
			{
				"text": "私も昔は、なんでも書き留めておく人でしてね",
				"tags": [
					"点あり"
				]
			},
			{
				"text": "紙は取っておくものですよ。あとで役に立つ",
				"tags": [
					"点あり"
				]
			},
			{
				"text": "あなた、几帳面ね。おばあさんに似たのかしら",
				"tags": [
					"点あり"
				]
			},
			{
				"text": "もう、めぼしいものは持っていかれましたね",
				"tags": [
					"交換済"
				]
			},
			{
				"text": "欲がないのね。うちの孫に見習わせたい",
				"tags": [
					"交換済"
				]
			},
			{
				"text": "持っていくものが無くなったら、話しに来なさい",
				"tags": [
					"交換済"
				]
			},
			{
				"text": "町じゅう歩きましたね、あなたも",
				"tags": [
					"全踏破"
				]
			},
			{
				"text": "もう案内はいりませんね",
				"tags": [
					"全踏破"
				]
			},
			{
				"text": "次はどこを探しましょうか",
				"tags": [
					"全踏破"
				]
			},
			{
				"text": "うちの人も、よく黙って出かける人でした",
				"tags": [
					"rare"
				]
			},
			{
				"text": "孫にはね、好きにさせておくのがいちばん",
				"tags": [
					"rare"
				]
			},
			{
				"text": "あなたのおばあさま、覚えてますよ。よく笑う人でね",
				"tags": [
					"rare"
				]
			},
			{
				"text": "たまには、一人で歩きたい日もあるでしょう",
				"tags": [
					"rare"
				]
			}
		]
	},
