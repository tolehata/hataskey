{
	"type": "module",
	"name": "cherrypick-js",
	"version": "11.4.0",
	"basedMisskeyVersion": "2026.7.0",
	"description": "Hataskey SDK for JavaScript",
	"license": "MIT",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"import": "./built/index.js",
			"types": "./built/index.d.ts",
			"default": "./built/index.js"
		},
		"./*": {
			"import": "./built/*",
			"types": "./built/*",
			"default": "./built/*"
		}
	},
	"scripts": {
		"build": "node ./build.js",
		"watch": "nodemon -w package.json -e json --exec \"node ./build.js --watch\"",
		"tsd": "tsd",
		"api": "pnpm api-extractor run --local --verbose",
		"api-prod": "pnpm api-extractor run --verbose",
		"eslint": "eslint './**/*.{js,jsx,ts,tsx}'",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm typecheck && pnpm eslint",
		"vitest": "vitest run --coverage",
		"test": "pnpm vitest && pnpm tsd",
		"update-autogen-code": "pnpm --filter cherrypick-js-type-generator generate && ncp generator/built/autogen src/autogen",
		"biome-lint": "pnpm typecheck && pnpm biome lint src",
		"format": "pnpm biome format",
		"format:write": "pnpm biome format --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kokonect-link/cherrypick.git",
		"directory": "packages/cherrypick-js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@microsoft/api-extractor": "7.58.9",
		"@types/node": "26.1.1",
		"@typescript-eslint/eslint-plugin": "8.63.0",
		"@typescript-eslint/parser": "8.63.0",
		"@vitest/coverage-v8": "4.1.10",
		"esbuild": "0.28.1",
		"execa": "9.6.1",
		"glob": "11.0.3",
		"ncp": "2.0.0",
		"nodemon": "3.1.10",
		"tsd": "0.33.0",
		"typescript": "6.0.2",
		"vitest": "4.1.10",
		"vitest-websocket-mock": "0.7.0"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"@simplewebauthn/server": "13.3.0",
		"eventemitter3": "5.0.1",
		"reconnecting-websocket": "4.4.0"
	}
}
